<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="Stage3_UML_Diagram" name="Stage 3">
    <mxGraphModel dx="3100" dy="3260" grid="1" gridSize="10" page="1" pageWidth="3100" pageHeight="3260">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Legend" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;UML notation&lt;/b&gt;&lt;br/&gt;+ public; - private; # protected. Underlined = static.&lt;br/&gt;Hollow triangle = inheritance; dashed triangle = realization.&lt;br/&gt;Filled diamond = composition; hollow diamond = aggregation.&lt;br/&gt;Dashed open arrow = dependency. Numbers are multiplicities.&lt;br/&gt;Reference-valued fields may be represented by association roles. Only key&lt;br/&gt;operations are shown.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="2020" y="300" width="410" height="112" />
        </mxCell>
        <mxCell id="DTOs" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;GameView records&lt;/b&gt;&lt;br/&gt;Nested immutable records:&lt;br/&gt;CustomerView&lt;br/&gt;TableView&lt;br/&gt;MenuItemView&lt;br/&gt;OrderView&lt;br/&gt;StaffView and HappyHourView are explicit boxes.&lt;br/&gt;Lists copied with List.copyOf; record accessors are implicit.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="2570" y="2170" width="430" height="124" />
        </mxCell>
        <mxCell id="OO" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;OO examples&lt;/b&gt;&lt;br/&gt;Customer state is private and changed through guarded operations.&lt;br/&gt;Loss, food choice and discount dispatch through Customer methods.&lt;br/&gt;StaffTeam owns independent Host/Waiter/Chef/Cashier. Restaurant owns HappyHourPolicy. Combo components are&lt;br/&gt;shared references, not exclusive ownership.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="30" y="2930" width="570" height="88" />
        </mxCell>
        <mxCell id="FunctionNote" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;Stage 3 dispatch, composition and policy&lt;/b&gt;&lt;br/&gt;Main passes customers::createCustomer as an IntFunction. CustomerFactory does not implement IntFunction, so there is no realization arrow between them. The controller stores the function, not a concrete CustomerFactory.&lt;br/&gt;Default seed 24369: Regular, VIP, Regular, Regular, Regular, Critic; six arrivals at 1/4/7/10/13/16. Regular/VIP cycle through the six orderable items; Critic chooses the most prep units, first tie. Happy Hour starts once, covers the current and next turn, and restores 15 waiting satisfaction at each opening (cap 100). Bills lock VIP then Happy Hour discounts when taken.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="780" y="2930" width="2270" height="64" />
        </mxCell>
