<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="Stage2_UML_Diagram" name="Stage 2">
    <mxGraphModel dx="2520" dy="2020" grid="1" gridSize="10" page="1" pageWidth="2520" pageHeight="2020">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Legend" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;UML notation&lt;/b&gt;&lt;br/&gt;+ public; - private; # protected. Underlined = static.&lt;br/&gt;Hollow triangle = inheritance; dashed triangle = realization.&lt;br/&gt;Filled diamond = composition; hollow diamond = aggregation.&lt;br/&gt;Dashed open arrow = dependency. Numbers are multiplicities.&lt;br/&gt;Reference-valued fields may be represented by association roles.&lt;br/&gt;Only key operations are shown.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="2010" y="310" width="350" height="112" />
        </mxCell>
        <mxCell id="DTOs" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;GameView records&lt;/b&gt;&lt;br/&gt;Nested immutable records:&lt;br/&gt;CustomerView&lt;br/&gt;TableView&lt;br/&gt;MenuItemView&lt;br/&gt;OrderView&lt;br/&gt;StaffView&lt;br/&gt;Lists copied with List.copyOf;&lt;br/&gt;record accessors are implicit.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="2270" y="1540" width="180" height="136" />
        </mxCell>
        <mxCell id="OO" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;OO examples&lt;/b&gt;&lt;br/&gt;Customer state is private and changed through&lt;br/&gt;guarded operations.&lt;br/&gt;Loss, food choice and discount dispatch through&lt;br/&gt;Customer methods.&lt;br/&gt;StaffTeam owns staff; SeatingArea owns two Tables&lt;br/&gt;and a WaitingQueue.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="30" y="1870" width="260" height="112" />
        </mxCell>
        <mxCell id="FunctionNote" value="&lt;div style=&quot;padding:8px&quot;&gt;&lt;b&gt;Stage 2 dispatch and reproducibility&lt;/b&gt;&lt;br/&gt;Main passes customers::createCustomer as an IntFunction. CustomerFactory does not implement IntFunction, so there is no realization arrow&lt;br/&gt;between them. The controller stores the function, not a concrete CustomerFactory.&lt;br/&gt;Default seed 24369: Regular, VIP, Regular, Regular, Regular, Critic. Six arrivals: 1, 4, 7, 10, 13, 16. Critic chooses the longest preparation&lt;br/&gt;time; ties use menu order. VIP discount is locked into the order bill.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontFamily=Helvetica;fontSize=10;strokeColor=#20252b;fillColor=#fafafa;">
          <mxGeometry as="geometry" x="1710" y="1830" width="740" height="88" />
        </mxCell>
